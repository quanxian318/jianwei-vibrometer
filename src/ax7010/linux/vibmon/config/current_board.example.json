{
  "device_id": "jianwei-ax7010",
  "camera": {
    "source": "pl_vdma",
    "pl_vdma": {
      "fps": 45,
      "left_camera": 1
    }
  },
  "measurement": {
    "duration_s": 10,
    "roi_width_px": 256,
    "roi_height_px": 192,
    "method": "multipoint",
    "multipoint": {
      "max_points": 12,
      "grid_cols": 4,
      "grid_rows": 3,
      "baseline_dir": "/root/vibmon/baselines"
    },
    "tracker": "lk",
    "calibration_file": "/root/vibmon/calibration.json"
  },
  "vision": {
    "enabled": true,
    "low_hz": 0.5,
    "high_hz": 2,
    "gain": 20
  },
  "stereo": {
    "work_width": 160,
    "pl_search_ranges": 2,
    "work_height": 90,
    "enabled": true,
    "calibration_file": "/root/vibmon_cam/an5642_stereo_nominal.json",
    "pl_core_base": "0x0",
    "pl_dma_base": "0x0",
    "pl_buffer_base": "0x1F800000",
    "pl_buffer_size": "0x100000",
    "max_skew_ms": 15,
    "refine_lk": false,
    "pl_vertical_check": true,
    "backend": "ps",
    "rate_hz": 1,
    "census": 5,
    "paths": 2,
    "max_disparity": 64,
    "fill_holes": false
  },
  "acoustic": {
    "enabled": true
  },
  "sensors": {
    "imu": {
      "enabled": false
    },
    "adxl345": {
      "enabled": false
    },
    "tof": {
      "enabled": false
    },
    "sht40": {
      "enabled": false
    }
  },
  "printer": {
    "enabled": true,
    "baud": 115200,
    "cts_flow_control": true,
    "raster_strip_rows": 24,
    "raster_pause_ms": 120,
    "status_query": "none",
    "feed_lines": 10,
    "feed_dots": 320,
    "power_on_wait_ms": 2000,
    "finish_margin_ms": 3000,
    "ms_per_raster_row": 4
  },
  "voice": {
    "enabled": false
  },
  "storage": {
    "records_dir": "/root/vibmon/records",
    "settings_file": "/root/vibmon/settings_an5642.json"
  },
  "ui": {
    "enabled": true,
    "display": "pl_vdma",
    "touch_device": "auto"
  },
  "control_socket": "/tmp/vibmon.sock",
  "poweroff_on_shutdown": false,
  "hardware": {
    "devices": {
      "uart_nano": "/dev/ttyPS1",
      "uart_printer": "axi16550:0x44050000",
      "i2c_management": "/dev/i2c-0",
      "i2c_sensors": "/dev/i2c-0"
    },
    "lamp_pwm_enabled": true,
    "lamp_pwm_base": "0x44070000"
  },
  "light": {
    "auto_on_measure": false
  },
  "alarm": {
    "binary_threshold": true,
    "warn_peak_to_peak": 0.01,
    "alarm_peak_to_peak": 0.02,
    "buzzer": true
  },
  "nano": {
    "baud": 115200,
    "flow_control": true,
    "offline_reset_ms": 0
  }
}
